{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flick",
  "version": "0.1.0",
  "identifier": "com.elirant3.flick",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
